<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Where <loan-compare> sends requests. Empty means same origin: open the site through
         LoanCalc.Gateway (http://localhost:5000), which routes /api to the API. -->
    <add key="LoanApiBaseUrl" value="" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <!-- LoanCalc.Core is netstandard2.0; pages compiled at runtime need the facade. -->
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
